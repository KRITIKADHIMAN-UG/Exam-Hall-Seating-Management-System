<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="700.0" prefWidth="1100.0" styleClass="root-bg" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.LoginController">
    <children>
        <VBox alignment="CENTER" spacing="15.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <Label text="IntelliSeat Login" styleClass="title-label"/>
                <VBox spacing="10.0" maxWidth="360.0" styleClass="card-panel">
                    <padding><Insets top="24.0" right="24.0" bottom="24.0" left="24.0"/></padding>
                    <children>
                        <TextField fx:id="usernameField" promptText="Username"/>
                        <PasswordField fx:id="passwordField" promptText="Password"/>
                        <Button text="Login" onAction="#handleLogin" styleClass="accent-button"/>
                        <Label text="Demo: admin / admin123" styleClass="muted-label"/>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
